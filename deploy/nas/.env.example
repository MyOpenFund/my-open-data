# .env of the stack built from compose.yaml. Placeholders only: never commit real values.
# my-open-data commit to install (40 hex characters). Its contract fingerprints must equal the
# producer's (`myopendata contracts list` on both sides), or batches are quarantined.
MYOPENDATA_REF=0000000000000000000000000000000000000000
# Store directory (landing/, lake/, backups/) and the uid:gid that owns it.
MYOPENDATA_HOST_DIR=/srv/my_open_data
MYOPENDATA_UID_GID=1000:1000
# Where the catalogue's Postgres port is published (its data lives in the Docker volume `pgdata`).
# Bind to a private address only:
# 127.0.0.1 on a laptop, a VPN/tailnet address on a server; never 0.0.0.0 on a public host.
MYOPENDATA_PG_BIND=127.0.0.1:5433
# Catalogue database and passwords (hex, e.g. `openssl rand -hex 24`: no quoting needed).
MYOPENDATA_CATALOG_DB=lake_catalog
MYOPENDATA_ADMIN_PASSWORD=change-me
MYOPENDATA_PUBLISHER_PASSWORD=change-me
MYOPENDATA_READER_PASSWORD=change-me
# Approvals, the reviewed step before a contract is published. Leave empty, or set both, e.g.
# MYOPENDATA_APPROVE=entity_observations:1 fundamentals:3 filing_statements:1 filings:1
# Approving again is a no-op.
MYOPENDATA_APPROVE=
MYOPENDATA_APPROVED_BY=
